# Public site URL used by canonical metadata, robots and sitemap.
NEXT_PUBLIC_SITE_URL=dmsapestcontrolservices.netlify.app

# Optional complete MapLibre style URL. When provided, this overrides the default CARTO basemap.
NEXT_PUBLIC_MAP_STYLE_URL=

# CARTO basemap key used by the default Voyager map. Request a free key at https://carto.com/basemaps/apikey/
NEXT_PUBLIC_CARTO_BASEMAP_KEY=cb1_2xz3_1_1cfe3f0669dc3e5589400282

# Free email provider: https://resend.com
RESEND_API_KEY=re_your_resend_api_key
CONTACT_RECIPIENT_EMAIL=dmsapestcontrolservices@gmail.com

# Optional public email shown in the contact page and footer. Leave empty until verified.
NEXT_PUBLIC_CONTACT_EMAIL=

# Use onboarding@resend.dev only while testing within Resend's restrictions.
CONTACT_FROM_EMAIL=DMSA Website <onboarding@resend.dev>

# Optional exact production origin, for example https://www.your-domain.example
CONTACT_ALLOWED_ORIGIN=

# Optional Google Search Console HTML-tag verification token.
